<!--
  Reconstructed lab artifact.
  Test in an authorized Wazuh lab before deployment.
  Rule IDs 100000-120000 are reserved by Wazuh documentation for custom rules.
-->
<group name="pam,syslog,lab_simulation,">
  <rule id="100100" level="10" frequency="3" timeframe="120" ignore="60">
    <if_matched_sid>5503</if_matched_sid>
    <same_srcip />
    <description>Lab simulation: repeated authentication failures for $(dstuser) from $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,brute_force,lab_simulation,</group>
  </rule>
</group>
